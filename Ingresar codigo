<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>3301 // ACERTIJO I</title>
<style>
  :root {
    --bg: #050505;
    --text: #d4d4d4;
    --green: #00ff41;
    --red: #ff3b3b;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: var(--bg); }
  body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
    font-family: 'Courier New', monospace;
    color: var(--text);
    line-height: 1.6;
  }
  main { width: 100%; max-width: 560px; text-align: center; }
  #cicada {
    display: block;
    margin: 0 auto 24px;
    max-width: 60%;
    max-height: 220px;
    height: auto;
  }
  h1 {
    margin: 0 0 16px;
    font-size: clamp(1.4rem, 6vw, 2.2rem);
    font-weight: normal;
    letter-spacing: 0.08em;
    color: var(--green);
    text-shadow: 0 0 8px rgba(0, 255, 65, 0.5);
  }
  .subtitle {
    margin: 0 auto 32px;
    max-width: 46ch;
    font-size: clamp(0.9rem, 3.6vw, 1rem);
  }
  form { display: flex; flex-direction: column; align-items: center; gap: 14px; }
  input[type="text"] {
    width: 100%;
    max-width: 320px;
    padding: 14px;
    background: transparent;
    border: 1px solid var(--green);
    border-radius: 0;
    color: var(--green);
    font-family: inherit;
    font-size: 1.1rem;
    text-align: center;
    letter-spacing: 0.2em;
    outline: none;
  }
  input[type="text"]:focus { box-shadow: 0 0 10px rgba(0, 255, 65, 0.45); }
  button {
    padding: 12px 32px;
    background: transparent;
    border: 1px solid var(--green);
    border-radius: 0;
    color: var(--green);
    font-family: inherit;
    font-size: 1rem;
    letter-spacing: 0.15em;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  button:hover, button:focus-visible { background: var(--green); color: var(--bg); outline: none; }
  button:disabled { opacity: 0.5; cursor: wait; }
  #error { min-height: 1.6em; margin-top: 18px; color: var(--red); }
  #success { display: none; }
  #success h2 {
    margin: 0 0 16px;
    font-size: clamp(1.3rem, 5.5vw, 2rem);
    font-weight: normal;
    color: var(--green);
    text-shadow: 0 0 10px rgba(0, 255, 65, 0.6);
  }
  #success p { margin: 0 auto; max-width: 46ch; }
</style>
</head>
<body>
<main>
  <img id="cicada" src="cicada.png" alt="" onerror="this.style.display='none'">

  <section id="puzzle">
    <h1>3301 // ACERTIJO I</h1>
    <p class="subtitle">La epifanía busca a quienes saben observar. Introduce el código hallado en el mundo físico.</p>
    <form id="form" autocomplete="off">
      <input type="text" id="code" inputmode="numeric" maxlength="32" aria-label="Código" autocomplete="off" autocapitalize="off" spellcheck="false">
      <button type="submit" id="btn">VERIFICAR</button>
    </form>
    <div id="error" role="alert"></div>
  </section>

  <section id="success">
    <h2>ACERTIJO I RESUELTO</h2>
    <p>Has demostrado que sabes buscar más allá de lo evidente. Prepárate. El siguiente paso de la Fase 1 aparecerá pronto. Buena suerte, 3301.</p>
  </section>
</main>

<script>
(function () {
  // Hash SHA-256 de la clave, ofuscado como códigos ASCII
  var H = [102,100,98,99,102,57,56,55,102,97,101,49,54,55,55,51,56,98,54,48,48,50,99,102,54,102,102,101,48,53,56,49,98,53,53,51,99,99,52,51,48,101,50,56,52,99,99,100,102,56,50,102,55,51,51,56,54,48,98,48,57,55,55,50];
  var EXPECTED = H.map(function (c) { return String.fromCharCode(c); }).join('');

  var WEBHOOK = 'https://discord.com/api/webhooks/1570900290276687962/YlotDqrKfCMwmdWMEkx2vzHnDYpFrV_aS3MvnfAdtdJy6rEd3FfsJua39ZJDAZg0I8UH';

  var form = document.getElementById('form');
  var input = document.getElementById('code');
  var btn = document.getElementById('btn');
  var errorBox = document.getElementById('error');
  var puzzle = document.getElementById('puzzle');
  var success = document.getElementById('success');
  var notified = false;

  async function sha256(text) {
    var data = new TextEncoder().encode(text);
    var buf = await crypto.subtle.digest('SHA-256', data);
    return Array.from(new Uint8Array(buf))
      .map(function (b) { return b.toString(16).padStart(2, '0'); })
      .join('');
  }

  function notifyDiscord() {
    if (notified) return;
    notified = true;
    var fecha = new Date().toLocaleString('es-ES', { dateStyle: 'full', timeStyle: 'medium' });
    try {
      fetch(WEBHOOK, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: '🟢 Alguien ha resuelto el Acertijo 1 — ' + fecha })
      }).catch(function () {});
    } catch (e) {}
  }

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    errorBox.textContent = '';
    btn.disabled = true;
    try {
      var hash = await sha256(input.value.trim());
      if (hash === EXPECTED) {
        form.style.display = 'none';
        puzzle.style.display = 'none';
        success.style.display = 'block';
        notifyDiscord();
      } else {
        errorBox.textContent = 'Acceso denegado. Código incorrecto.';
        input.select();
      }
    } catch (err) {
      errorBox.textContent = 'Error de verificación. Abre la página mediante HTTPS.';
    }
    btn.disabled = false;
  });
})();
</script>
</body>
</html>
